{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "postman": {
            "type": "http",
            "url": "https://mcp.postman.com/minimal",
            "headers": {
                "Authorization": "Bearer ${POSTMAN_API_KEY}"
            }
        }
    }
}
